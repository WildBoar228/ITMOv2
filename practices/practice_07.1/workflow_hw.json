      "id": "788de05f-7d74-471b-89ae-32f8dc1d7574",
      "name": "Prepare Review Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1376,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const context = $('Prepare Review Context').first().json;\nconst pr = $('Get PR Metadata').first().json;\nif (pr.number !== context.pr_number || pr.base?.repo?.full_name !== context.repository) {\n  throw new Error('Метаданные относятся к другому PR.');\n}\nif (!pr.head?.sha || !pr.base?.sha) throw new Error('В метаданных PR нет head.sha или base.sha.');\nif (!['main', 'other'].includes(context.review_branch)) throw new Error('Неизвестная ветка модели.');\nconst inputs = $input.all();\nconst files = inputs.map((item, inputIndex) => ({ file: item.json, inputIndex }))\n  .filter(({ file }) => Object.keys(file).length > 0);\nif (!Number.isInteger(pr.changed_files) || pr.changed_files > 3000 || files.length !== pr.changed_files) {\n  throw new Error('Получен неполный список файлов PR. Проверьте пагинацию /pulls/{number}/files (лимит GitHub: 3000).');\n}\nconst blocks = [];\nconst skippedFiles = [];\nconst seenPaths = new Set();\nfor (const { file } of files) {\n  if (typeof file.filename !== 'string' || !file.filename || seenPaths.has(file.filename)) {\n    throw new Error('В списке файлов отсутствует filename или повторяется путь.');\n  }\n  seenPaths.add(file.filename);\n  if (typeof file.patch !== 'string' || !file.patch.trim()) {\n    skippedFiles.push(file.filename);\n    continue;\n  }\n  const rows = file.patch.replace(/\\r\\n/g, '\\n').split('\\n');\n  if (rows.at(-1) === '') rows.pop();\n  let current = null;\n  let hunkNumber = 0;\n  let additions = 0;\n  let deletions = 0;\n  const finishHunk = () => {\n    if (!current) return;\n    if (current.oldSeen !== current.oldCount || current.newSeen !== current.newCount) {\n      throw new Error('Неполный patch: ' + file.filename + ', блок ' + hunkNumber);\n    }\n    if (!current.anchors.length) throw new Error('Блок не содержит изменённых строк: ' + file.filename);\n    blocks.push({\n      block_id: file.filename + ':hunk:' + hunkNumber,\n      path: file.filename,\n      patch: current.rows.join('\\n'),\n      anchors: current.anchors,\n    });\n  };\n  for (const row of rows) {\n    const header = /^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@/.exec(row);\n    if (header) {\n      finishHunk();\n      hunkNumber += 1;\n      current = {\n        oldLine: Number(header[1]), oldCount: header[2] === undefined ? 1 : Number(header[2]),\n        newLine: Number(header[3]), newCount: header[4] === undefined ? 1 : Number(header[4]),\n        oldSeen: 0, newSeen: 0, anchors: [], rows: [row],\n      };\n      continue;\n    }\n    if (!current) throw new Error('Не найден заголовок @@ в patch: ' + file.filename);\n    current.rows.push(row);\n    if (row.startsWith('\\\\ No newline at end of file')) continue;\n    if (row.startsWith('+')) {\n      current.anchors.push({ id: 'R' + current.newLine, line: current.newLine, side: 'RIGHT' });\n      current.newLine += 1; current.newSeen += 1; additions += 1;\n    } else if (row.startsWith('-')) {\n      current.anchors.push({ id: 'L' + current.oldLine, line: current.oldLine, side: 'LEFT' });\n      current.oldLine += 1; current.oldSeen += 1; deletions += 1;\n    } else if (row.startsWith(' ')) {\n      current.oldLine += 1; current.oldSeen += 1;\n      current.newLine += 1; current.newSeen += 1;\n    } else {\n      throw new Error('Неизвестный формат строки patch: ' + file.filename);\n    }\n  }\n  finishHunk();\n  if (!hunkNumber || (Number.isInteger(file.additions) && additions !== file.additions)\n      || (Number.isInteger(file.deletions) && deletions !== file.deletions)) {\n    throw new Error('Patch не покрывает все изменения файла: ' + file.filename);\n  }\n}\nreturn [{ json: { ...context, commit_sha: pr.head.sha, base_sha: pr.base.sha, blocks, skipped_files: skippedFiles } }];"
      },
      "id": "1b22030e-ab1a-4930-98d0-4e73c26d6755",
      "name": "Split PR Into Hunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        80
      ],
      "notesInFlow": true,
      "notes": "Каждый @@-блок получает block_id и список допустимых anchors. R — добавленная строка новой версии, L — удалённая строка старой. Проверяются размеры блоков, полнота patch и пагинации. Файлы без patch перечисляются в итоговом review."
    },
