    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"comments\"],\n  \"properties\": {\n    \"comments\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"block_id\", \"anchor_id\", \"body\"],\n        \"properties\": {\n          \"block_id\": { \"type\": \"string\" },\n          \"anchor_id\": { \"type\": \"string\" },\n          \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 6000 }\n        }\n      }\n    }\n  }\n}",
        "autoFix": false
      },
      "id": "4faf602d-9095-4f18-9a33-a6f1c70e177f",
      "name": "Hunk Review Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2720,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const source = $('Split PR Into Hunks').first().json;\nconst byBlock = new Map(source.blocks.map(block => [block.block_id, block]));\nconst validated = new Map();\nif (source.blocks.length) {\n  const result = $input.first().json.output;\n  if (!result || typeof result !== 'object' || !Array.isArray(result.comments)) {\n    throw new Error('Модель не вернула структурированный массив comments.');\n  }\n  for (const entry of result.comments) {\n    const block = byBlock.get(entry.block_id);\n    if (!block || validated.has(entry.block_id)) {\n      throw new Error('Неизвестный или повторяющийся block_id: ' + entry.block_id);\n    }\n    const anchor = block.anchors.find(candidate => candidate.id === entry.anchor_id);\n    if (!anchor || !Number.isInteger(anchor.line) || anchor.line < 1) {\n      throw new Error('Комментарий не привязан к изменённой строке блока: ' + entry.block_id);\n    }\n    if (typeof entry.body !== 'string' || !entry.body.trim() || entry.body.length > 6000) {\n      throw new Error('Пустой или слишком длинный комментарий: ' + entry.block_id);\n    }\n    validated.set(entry.block_id, {\n      path: block.path, line: anchor.line, side: anchor.side,\n      body: '**AI: ' + source.model + '** · ' + block.block_id + '\\n\\n' + entry.body.trim(),\n    });\n  }\n  if (validated.size !== source.blocks.length) {\n    throw new Error('Модель должна вернуть ровно один комментарий для каждого блока diff.');\n  }\n}\nconst comments = source.blocks.map(block => validated.get(block.block_id));\nlet body = 'AI-ревью моделью ' + source.model + '. Проверено блоков изменений: ' + comments.length + '.';\nif (!comments.length) body += '\\nТекстовых блоков для inline-комментариев нет; модель не вызывалась.';\nif (source.skipped_files.length) {\n  body += '\\n\\nФайлы без доступного текстового patch (не проверены):\\n'\n    + source.skipped_files.map(path => '- ' + path).join('\\n');\n}\nreturn [{ json: {\n  pr_id: source.pr_id, repository: source.repository, pr_number: source.pr_number,\n  model: source.model, review_branch: source.review_branch, commit_sha: source.commit_sha, base_sha: source.base_sha,\n  review: { commit_id: source.commit_sha, event: 'COMMENT', body, comments },\n} }];"
      },
      "id": "18a0c1e8-7cf3-4286-9c08-867b4d1768ad",
