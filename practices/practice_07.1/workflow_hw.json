        "jsCode": "const review = $('Build Inline Review').first().json;\nconst current = $input.first().json;\nif (current.number !== review.pr_number || current.base?.repo?.full_name !== review.repository\n    || current.head?.sha !== review.commit_sha || current.base?.sha !== review.base_sha) {\n  throw new Error('PR изменился во время ревью. Публикация отменена; отправьте команду снова для нового diff.');\n}\nreturn [{ json: review }];"
